# Copy to apps/web/.env.local for local overrides. Nothing here is required to run locally.
# Every variable is described in docs/self-hosting.md.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production
FLEXWALL_SECRET=
FLEXWALL_ENCRYPTION_KEY=

# Persistence (empty: in-memory store)
GOOGLE_PROJECT_ID=

# Email (empty: sign-in links printed in the server log)
EMAIL_IMPERSONATE=
EMAIL_FROM=

# Billing (empty: payments off)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# Shared with connectors
GITHUB_TOKEN=
YOUTUBE_API_KEY=

MODERATION_INBOX=
