# ── Secrets (Secret Manager in production) ──
# Signs the private image and edit links. Changing it invalidates every link.
FLEXWALL_SECRET=
# Seals connector secrets (Stripe keys, API headers). openssl rand -base64 32
FLEXWALL_ENCRYPTION_KEY=
# Without STRIPE_SECRET_KEY, Pro checkout answers 503 and the editor says so.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firestore ──
# Empty locally: walls live in process memory. On Cloud Run, the project id;
# the service account provides auth. Collections are prefixed fw_.
GOOGLE_PROJECT_ID=

# ── Pro receipt email (Gmail API, domain-wide delegation) ──
EMAIL_IMPERSONATE=
EMAIL_FROM=

# ── Optional ──
# No-scope token: GitHub API limit 60 → 5000 calls an hour (followers, stars).
GITHUB_TOKEN=
