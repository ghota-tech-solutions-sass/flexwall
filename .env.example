# ── Stripe (required in production) ──
# Without STRIPE_SECRET_KEY the app runs in demo mode: the board renders
# seeded data and checkout returns 503 payments_not_configured.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
MIN_ENTRY_USD=1000

# ── Session "my seat" (cookie signé) ──
# En prod : généré par Terraform (Secret Manager). En dev, laisse vide.
AUTH_SESSION_SECRET=

# ── Firestore (optional locally) ──
# Émulateur officiel en Docker (aucun credential requis) :
#   docker run -d --name fw-firestore-emulator -p 8080:8080 \
#     gcr.io/google.com/cloudsdktool/google-cloud-cli:emulators \
#     gcloud beta emulators firestore start --host-port=0.0.0.0:8080
# Puis décommente les deux lignes ci-dessous :
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_PROJECT_ID=demo-flexwall
# On Cloud Run the attached service account provides auth automatically.
# Without valid ADC credentials locally, the app falls back to an in-memory
# demo store.
GOOGLE_PROJECT_ID=my-project-id

# ── Email (magic links + welcome mail) via Google Workspace / Gmail API ──
# Set by Terraform in prod (email_impersonate / email_from). Locally leave empty:
# the email path answers 503 and the UI tells the user to use the paid-from browser.
EMAIL_IMPERSONATE=
EMAIL_FROM=
